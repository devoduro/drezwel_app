APP_NAME="Drezwel Go"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/drezwel_app/public
APP_TIMEZONE=Africa/Accra

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drezwel_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

SMS_PROVIDER=speso
SPESO_API_KEY=
SPESO_SMS_SENDER_ID=Drezwel
SPESO_BASE_URL=https://business.speso.co/api/v1
# Online payment at checkout. Create the webhook secret at business.speso.co/developer.
# The callback must be a public https URL; on localhost the order page polls Speso instead.
SPESO_WEBHOOK_SECRET=
SPESO_CALLBACK_URL="${APP_URL}/webhooks/speso"
SPESO_ABANDON_AFTER=60
